APP_NAME=Jarvis Conversation Service
APP_VERSION=0.1.0
API_PREFIX=/api/v1

DATABASE_URL=postgresql://jarvis:jarvis@localhost:5433/jarvis_conversations

# Must match jarvis-backend's INTERNAL_API_KEY — this is the shared secret
# that proves a request actually came from jarvis-backend, since this
# service is never reachable from the frontend/ingress.
INTERNAL_API_KEY=changeme-dev-only
